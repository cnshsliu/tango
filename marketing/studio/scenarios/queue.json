{
  "cols": 104,
  "rows": 32,
  "title": "tango — ~/demo-ledger",
  "cover": "02-queue-dialog",
  "config": { "nvimViewer": "internal" },
  "setup": [
    "ledger add 38.5 餐饮 午饭 >/dev/null",
    "ledger add 6 交通 地铁 >/dev/null",
    "ledger add 128 日用 洗衣液和纸巾 >/dev/null",
    "ledger add 22 餐饮 咖啡 >/dev/null",
    "ledger add 399 数码 机械键盘 >/dev/null",
    "ledger add 45.8 餐饮 晚饭 >/dev/null",
    "ledger add 160 运动 羽毛球场地 >/dev/null"
  ],
  "turns": [
    [
      { "delay": 2500, "thinking": "先拿到这个月按类别的汇总。", "text": "先看这个月的分类汇总。", "tools": [{ "name": "bash", "args": { "command": "ledger month" } }] },
      { "delay": 4000, "text": "再拉一下明细，核对每类的笔数。", "tools": [{ "name": "bash", "args": { "command": "ledger list 50" } }] },
      { "delay": 5000, "thinking": "明细和汇总对得上，共 7 笔。接下来整理成表格。", "text": "明细和汇总对得上。我再对一遍笔数。", "tools": [{ "name": "bash", "args": { "command": "ledger list 50 | wc -l" } }] },
      { "delay": 5000, "text": "数据齐了，开始写报告。", "tools": [{ "name": "bash", "args": { "command": "ledger month" } }] },
      { "delay": 1500, "text": "report.md 写好了。" },
      { "afterSupplement": true, "delay": 1500, "thinking": "用户补充：金额保留两位小数。写报告时按 ¥0.00 格式。", "text": "收到补充：金额统一保留两位小数。", "tools": [{ "name": "write", "args": { "path": "report.md", "content": "# 2026 年 11 月支出\n\n| 类别 | 金额 |\n| --- | ---: |\n| 数码 | ¥399.00 |\n| 运动 | ¥160.00 |\n| 日用 | ¥128.00 |\n| 餐饮 | ¥106.30 |\n| 交通 | ¥6.00 |\n| **合计** | **¥799.30** |\n" } }] },
      { "afterSupplement": true, "delay": 800, "text": "report.md 写好了：5 个类别，合计 ¥799.30，金额都保留两位小数。" }
    ],
    [
      { "delay": 1200, "tools": [{ "name": "bash", "args": { "command": "ledger list 50" } }] },
      { "delay": 1000, "text": "这个月超过 100 元的支出有 3 笔：机械键盘 ¥399.00、羽毛球场地 ¥160.00、洗衣液和纸巾 ¥128.00。" }
    ]
  ],
  "tape": [
    ["wait", "idle", 15],
    ["sleep", 0.8],
    ["type", "统计这个月每类花了多少，写成 report.md"],
    ["key", "Enter"],
    ["wait", "先看这个月的分类汇总", 20],
    ["sleep", 0.8],
    ["type", "列出这个月超过 100 元的支出"],
    ["key", "Enter"],
    ["sleep", 0.8],
    ["type", "把 report.md 翻译成英文"],
    ["key", "Enter"],
    ["wait", "已排队 2", 10],
    ["sleep", 1.2],
    ["shot", "01-queued"],
    ["type", "/queue"],
    ["key", "Enter"],
    ["sleep", 1.5],
    ["shot", "02-queue-dialog"],
    ["key", "2"],
    ["sleep", 0.6],
    ["key", "d"],
    ["sleep", 1.2],
    ["shot", "02b-queue-deleted"],
    ["key", "Escape"],
    ["sleep", 0.6],
    ["type", "金额保留两位小数"],
    ["key", "M-Enter"],
    ["wait", "收到补充", 30],
    ["wait", "合计 ¥799.30", 20],
    ["sleep", 1.0],
    ["shot", "03-supplement"],
    ["wait", "超过 100 元的支出有 3 笔", 30],
    ["sleep", 2.0],
    ["shot", "04-auto-sent"]
  ]
}
