{
  "name": "tango",
  "version": "0.1.0",
  "description": "Tango — it takes two. A light agent harness for work and code.",
  "type": "module",
  "private": true,
  "bin": {
    "tango": "./tui/target/release/tango-tui",
    "tang": "./tui/target/release/tango-tui"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:ts && npm run test:tui",
    "test:ts": "node --import tsx --test tests/**/*.test.ts",
    "test:tui": "cd tui && cargo test -q",
    "test:hooks": "node scripts/hooks/hook-guard.mjs --check"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pyright": "^1.1.414",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
